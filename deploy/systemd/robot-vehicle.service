[Unit]
Description=RDK Robot Vehicle Gateway
After=local-fs.target

[Service]
Type=simple
# Set User= to an unprivileged deployment account with dialout/CAN permissions.
WorkingDirectory=/userdata/rdkstudio/projects/robot_car
Environment=PYTHONPATH=/userdata/rdkstudio/projects:/userdata/rdkstudio/projects/robot_car/src
Environment=ROBOT_CAR_RUNTIME=/userdata/robot-car/runtime
ExecStart=/usr/bin/python3 -m robot_car.vehicled --config-dir config --transport fake
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
